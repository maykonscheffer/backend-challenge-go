# For running the Go executable on the host after starting Compose dependencies.
DATABASE_URL=postgres://wallet_app:local-app-password@localhost:15432/wallet?sslmode=disable
OIDC_ISSUER=http://localhost:8180/realms/wallet
OIDC_JWKS_URL=http://localhost:8180/realms/wallet/protocol/openid-connect/certs
OIDC_AUDIENCE=wallet-api
HTTP_ADDR=:8083
# Host execution additionally requires an explicitly reachable broker endpoint and
# the generated wallet-service credentials. Compose configures both automatically
# inside its network; it intentionally does not expose SQS to the host.
AWS_REGION=us-east-1
AWS_PROFILE=wallet-service
AWS_SHARED_CREDENTIALS_FILE=/credentials/credentials
SQS_ENDPOINT=http://ministack:4566
SQS_ALLOWED_PROVIDERS=provider-a,provider-b

# Optional tracing; disabled unless explicitly enabled.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=wallet-api
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT must be reachable by the API process.
